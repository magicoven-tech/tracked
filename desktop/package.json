    "bonjour-service": "^1.3.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "mqtt": "^5.10.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.14",
    "wait-on": "^8.0.1"
  }
}
